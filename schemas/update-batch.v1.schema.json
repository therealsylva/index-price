{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/therealsylva/index-price/schemas/update-batch.v1.schema.json",
  "title": "Blackbook Index Update Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "from", "asOf", "provider", "expectedMatchIds"],
  "properties": {
    "schema": {
      "const": "blackbook.index.update-batch.v1"
    },
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "const": "fotmob"
    },
    "expectedMatchIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(fotmob:)?[0-9]+$"
      }
    }
  }
}
